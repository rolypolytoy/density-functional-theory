&CONTROL
  calculation = 'scf'
  prefix = 'snse'
  outdir = './bulk/'
  pseudo_dir = './'
  verbosity = 'high'
  tprnfor = .true.
  tstress = .true.
/

&SYSTEM
  ibrav = 0
  nat = 8
  ntyp = 2
  ecutwfc = 50
  ecutrho = 400
  input_dft = 'pbe'
  occupations = 'fixed'
  smearing = 'gaussian'
  nbnd = 100
/

&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.3
  mixing_mode = 'plain'
  startingpot = 'atomic'
/

ATOMIC_SPECIES
Sn  118.710  Sn.pbe-dn-kjpaw_psl.1.0.0.UPF
Se   78.960  Se.pbe-dn-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
