&control
 calculation = 'scf'
 prefix = 'CuO'
 pseudo_dir = './'
 outdir = './tmp/'
 verbosity = 'high'
/
&system
 ibrav = 0
 nat = 8, ntyp = 2
 ecutwfc = 60
 ecutrho = 480
 occupations = 'fixed'
 input_dft = 'pbe'
 nbnd = 50
/
&electrons
 mixing_beta = 0.3
 conv_thr = 1.0d-6
/
ATOMIC_SPECIES
Cu 63.546 Cu.pbe-dn-kjpaw_psl.1.0.0.UPF
O  15.999 O.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
4.24947000 0.00000000 0.00000000
0.00000000 4.06086200 0.00000000
-0.22533800 0.00000000 5.15579900
ATOMIC_POSITIONS crystal
Cu 0.25000000 0.75000000 0.50000000
Cu 0.75000000 0.75000000 0.00000000
Cu 0.75000000 0.25000000 0.50000000
Cu 0.25000000 0.25000000 0.00000000
O  0.00000000 0.51387200 0.75000000
O  0.00000000 0.48612800 0.25000000
O  0.50000000 0.01387200 0.75000000
O  0.50000000 0.98612800 0.25000000
K_POINTS automatic
6 6 6 0 0 0
