&CONTROL
  calculation = 'scf'
  prefix = 'sns'
  outdir = './bi'
  pseudo_dir = './'
  verbosity = 'high'
  tprnfor = .true.
  tstress = .true.
/
&SYSTEM
  ibrav = 0
  nat = 16
  ntyp = 2
  ecutwfc = 50
  ecutrho = 400
  input_dft = 'pbe'
  occupations = 'fixed'
  smearing = 'gaussian'
  nbnd = 200
/
&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.3
  mixing_mode = 'plain'
  startingpot = 'atomic'
/
